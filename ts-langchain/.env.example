# LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=step-3.7-flash
OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
IMAGE_MODEL=step-image-edit-2

# Timeout and loop budgets
AGENT_DEADLINE_MS=120000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
MAX_AGENT_ITERATIONS=6

# Web search (Tavily is the single search backend)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# API
PORT=6001
CORS_ORIGIN=http://localhost:3000

# Cloudflare Memory Gateway
CLOUDFLARE_MEMORY_BASE_URL=your_worker_url
CLOUDFLARE_MEMORY_SECRET=your_secret_here

# ============ 持久化开关 ============
# 设为 false 可跳过所有 D1/Vectorize/AI 调用，纯内存运行
# 适用于 Cloudflare 网络不通等临时场景
PERSISTENCE_ENABLED=true

# file.read 可访问的根目录（默认当前进程目录）
# AGENT_WORKSPACE_ROOT=D:\\agent\\ts-langchain
