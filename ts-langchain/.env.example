# LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=step-3.7-flash
OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
IMAGE_MODEL=step-image-edit-2

# Web search (Tavily is the single search backend)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# API
PORT=6001
CORS_ORIGIN=http://localhost:3000

# file.read 可访问的根目录（默认当前进程目录）
# AGENT_WORKSPACE_ROOT=D:\\agent\\ts-langchain
