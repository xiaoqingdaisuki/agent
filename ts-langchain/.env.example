# 模型服务配置
LLM_PROVIDER=openai
OPENAI_API_KEY=change-me
OPENAI_MODEL=change-me
OPENAI_BASE_URL=change-me
# 可选：文本模型通过 Cloudflare AI Gateway 转发，配置后优先于 OPENAI_BASE_URL
# CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/default/custom-agent-dots/v1
# CLOUDFLARE_AI_GATEWAY_TOKEN=
# Cloudflare Workers AI 文生图配置，独立于上方文本模型服务
IMAGE_API_KEY=change-me
IMAGE_BASE_URL=change-me
IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# 可选：切换到 Anthropic 提供方
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 请求超时与循环次数预算
AGENT_DEADLINE_MS=240000
AGENT_DEADLINE_WITH_TOOLS_MS=240000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=0
# Agent token 预算：上下文 128k、输入 48k、输出 16k
LLM_MAX_CONTEXT_TOKENS=128000
LLM_MAX_INPUT_TOKENS=48000
LLM_MAX_OUTPUT_TOKENS=16000
HISTORY_CONTEXT_TOKEN_BUDGET=48000
LLM_MAX_CONCURRENCY=2
MAX_AGENT_ITERATIONS=6
# 限制非关键持久化与刷新任务的并发及队列，避免依赖故障耗尽进程资源
BACKGROUND_TASK_CONCURRENCY=4
BACKGROUND_TASK_QUEUE_MAX=200

# 网页搜索，统一使用 Tavily 数据源
TAVILY_API_KEY=change-me
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# API 服务配置
PORT=6001
CORS_ORIGIN=http://localhost:3000
AGENT_API_SECRET=replace-with-a-long-random-secret

# Cloudflare 记忆网关
# Cloudflare 部署中保持启用，使用户记忆与持久化 RAG 使用记忆网关及 D1
# 仅在本地进程内记忆测试时设为 false，进程重启后数据会丢失
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
CLOUDFLARE_MEMORY_BASE_URL=your_worker_url
CLOUDFLARE_MEMORY_SECRET=your_secret_here
