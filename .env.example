# 复制此文件为 .env 并替换所有 change-me 占位值

# 两个实现共享的模型服务配置
LLM_PROVIDER=openai
OPENAI_API_KEY=change-me
OPENAI_MODEL=change-me
OPENAI_BASE_URL=change-me
# 设置 LLM_PROVIDER=anthropic 后使用以下认证信息
# ANTHROPIC_API_KEY=change-me
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Cloudflare Workers AI 文生图配置，独立于上方文本模型服务
IMAGE_API_KEY=change-me
IMAGE_BASE_URL=change-me
IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev

# 超时预算顺序：Agent 对话或工具（120 秒或 300 秒）小于服务端（310 秒），服务端小于 Vibe 代理（320 秒）
AGENT_DEADLINE_MS=120000
AGENT_DEADLINE_WITH_TOOLS_MS=240000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
MAX_AGENT_ITERATIONS=6
AGENT_API_SECRET=change-me

# 实时网页搜索，统一使用 Tavily 数据源
TAVILY_API_KEY=change-me
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# 允许调用 API 的浏览器来源，多个来源以逗号分隔
# 填写前端实际使用的协议和主机，例如 https://app.example.com
CORS_ORIGIN=http://localhost:3000

# 两个 Agent 实现共享的 Cloudflare 记忆网关
# Cloudflare 部署中保持启用，使用户记忆与持久化 RAG 使用记忆网关及 D1
# 仅在本地进程内记忆测试时设为 false，进程重启后数据会丢失
MEMORY_ENABLED=true
CLOUDFLARE_MEMORY_BASE_URL=https://change-me.workers.dev
CLOUDFLARE_MEMORY_SECRET=change-me

# ECS 对外端口，仅在安全组中开放所选服务对应的端口
TS_PUBLIC_PORT=6001
PY_PUBLIC_PORT=6002

# Python 构建依赖源，ECS 无法访问 PyPI 时使用可访问的镜像源
PYPI_SOURCE_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY_URL=https://registry.npmmirror.com
