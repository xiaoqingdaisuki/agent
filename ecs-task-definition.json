{
  "family": "agent-task",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskRole",
  "volumes": [
    {
      "name": "qdrant-storage",
      "efsVolumeConfiguration": {
        "fileSystemId": "<EFS_ID>",
        "rootDirectory": "/"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "ts-agent",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/ts-agent:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "6001" },
        { "name": "OPENAI_MODEL", "value": "gpt-4o-mini" },
        { "name": "OPENAI_BASE_URL", "value": "https://api.openai.com/v1" },
        { "name": "AGENT_DEADLINE_MS", "value": "30000" },
        { "name": "SERVER_REQUEST_TIMEOUT_MS", "value": "40000" },
        { "name": "LLM_TIMEOUT_MS", "value": "12000" },
        { "name": "LLM_MAX_RETRIES", "value": "1" },
        { "name": "MAX_AGENT_ITERATIONS", "value": "6" },
        { "name": "TAVILY_SEARCH_DEPTH", "value": "basic" },
        { "name": "SEARCH_TIMEOUT_MS", "value": "4500" },
        { "name": "SEARCH_MAX_RESULTS", "value": "8" },
        { "name": "SEARCH_CACHE_TTL_SECONDS", "value": "30" },
        { "name": "SEARCH_STALE_TTL_SECONDS", "value": "600" },
        { "name": "CORS_ORIGIN", "value": "https://app.example.com" },
        { "name": "QDRANT_URL", "value": "http://qdrant:6333" }
      ],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/OPENAI_API_KEY"
        },
        {
          "name": "TAVILY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/TAVILY_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-ts",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q --spider http://127.0.0.1:6001/api/v1/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 20
      },
      "resourceRequirements": [
        { "type": "CPU", "value": "256" },
        { "type": "MEMORY", "value": "512" }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      }
    },
    {
      "name": "py-agent",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/py-agent:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "6002" },
        { "name": "OPENAI_MODEL", "value": "gpt-4o-mini" },
        { "name": "OPENAI_BASE_URL", "value": "https://api.openai.com/v1" },
        { "name": "AGENT_DEADLINE_MS", "value": "30000" },
        { "name": "SERVER_REQUEST_TIMEOUT_MS", "value": "40000" },
        { "name": "LLM_TIMEOUT_MS", "value": "12000" },
        { "name": "LLM_MAX_RETRIES", "value": "1" },
        { "name": "MAX_AGENT_ITERATIONS", "value": "6" },
        { "name": "TAVILY_SEARCH_DEPTH", "value": "basic" },
        { "name": "SEARCH_TIMEOUT_MS", "value": "4500" },
        { "name": "SEARCH_MAX_RESULTS", "value": "8" },
        { "name": "SEARCH_CACHE_TTL_SECONDS", "value": "30" },
        { "name": "SEARCH_STALE_TTL_SECONDS", "value": "600" },
        { "name": "CORS_ORIGIN", "value": "https://app.example.com" },
        { "name": "POSTGRES_DB", "value": "agent" },
        { "name": "POSTGRES_USER", "value": "agent" },
        { "name": "QDRANT_URL", "value": "http://qdrant:6333" }
      ],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/OPENAI_API_KEY"
        },
        {
          "name": "TAVILY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/TAVILY_API_KEY"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/POSTGRES_PASSWORD"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-py",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:6002/api/v1/health', timeout=3)\" || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 20
      },
      "resourceRequirements": [
        { "type": "CPU", "value": "256" },
        { "type": "MEMORY", "value": "512" }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5432,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "POSTGRES_DB", "value": "agent" },
        { "name": "POSTGRES_USER", "value": "agent" }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:agent/POSTGRES_PASSWORD"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "postgres-data",
          "containerPath": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-postgres",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U agent -d agent"],
        "interval": 10,
        "timeout": 5,
        "retries": 5
      },
      "resourceRequirements": [
        { "type": "CPU", "value": "256" },
        { "type": "MEMORY", "value": "512" }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      }
    },
    {
      "name": "qdrant",
      "image": "qdrant/qdrant:v1.15.1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 6333,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "qdrant-storage",
          "containerPath": "/qdrant/storage",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-qdrant",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "bash -c ':> /dev/tcp/127.0.0.1/6333' || exit 1"],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 10
      },
      "resourceRequirements": [
        { "type": "CPU", "value": "256" },
        { "type": "MEMORY", "value": "512" }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
