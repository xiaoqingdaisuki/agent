# LLM Provider
OPENAI_API_KEY=change-me
OPENAI_MODEL=change-me
OPENAI_BASE_URL=change-me
# Cloudflare Workers AI text-to-image (independent from the LLM provider above)
IMAGE_API_KEY=change-me
IMAGE_BASE_URL=change-me
IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# 可选：切换到 Anthropic 提供方
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-4-8-opus

# Timeout and loop budgets
AGENT_DEADLINE_MS=120000
AGENT_DEADLINE_WITH_TOOLS_MS=300000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=2
BACKGROUND_TASK_CONCURRENCY=4
BACKGROUND_TASK_QUEUE_MAX=200
MAX_AGENT_ITERATIONS=6

# Web search (Tavily is the single search backend)
TAVILY_API_KEY=change-me
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# API
HOST=0.0.0.0
PORT=6002
CORS_ORIGIN=http://localhost:3000
AGENT_API_SECRET=replace-with-a-long-random-secret

# Cloudflare Memory Gateway
# Set to false for in-process memory mode. No Gateway/D1/vector calls are made; data is lost on restart.
MEMORY_ENABLED=false
CLOUDFLARE_MEMORY_BASE_URL=your_worker_url
CLOUDFLARE_MEMORY_SECRET=your_secret_here
