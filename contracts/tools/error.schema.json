{
  "$schema": "http://json-schema.org/draft/07/schema#",
  "title": "ToolResultEnvelope",
  "description": "所有工具调用的统一返回信封",
  "type": "object",
  "required": ["ok", "data", "error", "meta"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "调用是否成功"
    },
    "data": {
      "description": "成功时的结构化数据（可为 null）"
    },
    "error": {
      "type": ["object", "null"],
      "description": "失败时的错误信息，成功时为 null",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT", "UNAUTHENTICATED", "PERMISSION_DENIED",
            "POLICY_DENIED", "APPROVAL_REQUIRED", "NOT_FOUND", "CONFLICT",
            "RATE_LIMITED", "TIMEOUT", "DEPENDENCY_ERROR",
            "RESULT_TOO_LARGE", "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "description": "面向用户的错误描述"
        },
        "details": {
          "type": "object",
          "description": "附加调试信息（生产环境通常省略）"
        }
      },
      "required": ["code", "message"]
    },
    "meta": {
      "type": "object",
      "required": ["tool_call_id", "duration_ms"],
      "properties": {
        "tool_call_id": {
          "type": "string",
          "description": "唯一标识本次工具调用"
        },
        "tool_name": {
          "type": "string",
          "description": "实际调用的工具名"
        },
        "tool_version": {
          "type": "string",
          "description": "工具版本"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "执行耗时（毫秒）"
        },
        "source_refs": {
          "type": "array",
          "items": {"type": "string"},
          "default": [],
          "description": "引用来源列表（如文档ID、URL）"
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"},
          "default": [],
          "description": "非致命警告"
        },
        "retryable": {
          "type": "boolean",
          "default": false,
          "description": "是否可安全重试"
        }
      }
    }
  }
}
