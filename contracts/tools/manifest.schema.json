{
  "$schema": "http://json-schema.org/draft/07/schema#",
  "title": "ToolDescriptor",
  "description": "语言无关的工具契约定义",
  "type": "object",
  "required": [
    "name", "version", "title", "description", "category",
    "risk_level", "side_effect", "timeout_ms", "input_schema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "description": "工具全限定名，格式: domain.action，如 web.search、file.read"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本号"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "人类可读的工具名称"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "工具用途说明，供模型理解何时调用"
    },
    "category": {
      "type": "string",
      "enum": ["READ", "SEARCH", "ACTION", "COMPUTE", "MEMORY", "CONTROL", "GUARD"],
      "description": "工具所属能力类别"
    },
    "risk_level": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3"],
      "description": "风险等级：R0无副作用, R1只读, R2有副作用可恢复, R3高风险需审批"
    },
    "side_effect": {
      "type": "string",
      "enum": ["none", "read", "write", "external"],
      "description": "副作用类型"
    },
    "idempotent": {
      "type": "boolean",
      "default": true,
      "description": "是否幂等（重复调用结果一致）"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000,
      "description": "单次调用超时（毫秒）"
    },
    "required_permissions": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "调用所需权限列表"
    },
    "approval_policy": {
      "type": "string",
      "enum": ["never", "conditional", "always"],
      "default": "never",
      "description": "审批策略：never=无需审批, conditional=根据参数/用户判断, always=必须审批"
    },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema 严格模式定义输入参数"
    },
    "output_schema": {
      "type": "object",
      "description": "JSON Schema 定义输出结构（可选）"
    },
    "data_classification": {
      "type": "array",
      "items": {"type": "string", "enum": ["public", "internal", "confidential", "pii"]},
      "default": ["internal"],
      "description": "数据敏感级别"
    },
    "owner": {
      "type": "string",
      "description": "工具负责团队/模块"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "标签，用于分类和检索"
    }
  }
}
