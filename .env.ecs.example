# Copy this file to .env.ecs and replace every change-me value.

# LLM provider shared by both implementations
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=step-image-edit-2

# Timeout budget: Agent (120s) < server/gateway (310s) < Vibe proxy (320s).
AGENT_DEADLINE_MS=120000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
MAX_AGENT_ITERATIONS=6

# Real-time web search (Tavily is the single search backend).
TAVILY_API_KEY=change-me
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# Browser origins allowed to call the API. Separate multiple origins with commas.
# Use the exact frontend scheme and host, for example: https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Public ECS ports. Open only the selected port(s) in the ECS security group.
TS_PUBLIC_PORT=6001
PY_PUBLIC_PORT=6002
