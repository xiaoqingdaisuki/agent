# Copy this file to .env.ecs and replace every change-me value.

# LLM provider shared by both implementations
OPENAI_API_KEY=change-me
OPENAI_MODEL=change-me
OPENAI_BASE_URL=change-me
# Cloudflare Workers AI text-to-image (independent from the LLM provider above)
IMAGE_API_KEY=change-me
IMAGE_BASE_URL=change-me
IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Timeout budget: Agent chat/tool (120s/300s) < server (310s) < Vibe proxy (320s).
AGENT_DEADLINE_MS=120000
AGENT_DEADLINE_WITH_TOOLS_MS=300000
SERVER_REQUEST_TIMEOUT_MS=310000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
MAX_AGENT_ITERATIONS=6
AGENT_API_SECRET=change-me

# Real-time web search (Tavily is the single search backend).
TAVILY_API_KEY=change-me
TAVILY_SEARCH_DEPTH=basic
SEARCH_TIMEOUT_MS=4500
SEARCH_MAX_RESULTS=8
SEARCH_CACHE_TTL_SECONDS=30
SEARCH_STALE_TTL_SECONDS=600

# Browser origins allowed to call the API. Separate multiple origins with commas.
# Use the exact frontend scheme and host, for example: https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Cloudflare Memory Gateway shared by both Agent implementations.
CLOUDFLARE_MEMORY_BASE_URL=https://change-me.workers.dev
CLOUDFLARE_MEMORY_SECRET=change-me

# Public ECS ports. Open only the selected port(s) in the ECS security group.
TS_PUBLIC_PORT=6001
PY_PUBLIC_PORT=6002
